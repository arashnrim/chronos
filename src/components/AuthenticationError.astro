---
import { IconHandStop } from "@tabler/icons-react";
---

<section
  data-auth-error
  class="fixed inset-0 z-50 hidden min-h-dvh place-items-center bg-black/35 px-6 py-12 backdrop-blur-sm"
  role="alert"
>
  <div class="w-full max-w-md rounded-2xl border border-border bg-card p-8 text-center text-card-foreground shadow-2xl sm:p-10">
    <IconHandStop className="mx-auto mt-4 h-16 w-16 text-destructive mb-4" />
    <h1 id="auth-error-title" class="text-3xl font-bold tracking-tight">
      Halt! Who goes there?
    </h1>
    <p data-auth-description class="mt-4 text-muted-foreground">
      Just enter your name and the password to continue. The capitalisation
      doesn't matter, just spell properly can already.
    </p>
    <button
      data-auth-button
      class="mt-6 inline-flex h-9 items-center justify-center rounded-4xl bg-primary px-4 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      type="button"
    >
      Let me in leh
    </button>
    <p data-retry-hint hidden class="mt-4 text-xs text-muted-foreground">
      Nothing happening after clicking the button? Try closing your browser and
      loading the page again.
    </p>
  </div>
</section>

<script>
  const errorScreen = document.querySelector<HTMLElement>("[data-auth-error]");
  const errorDescription = errorScreen?.querySelector<HTMLElement>(
    "[data-auth-description]",
  );
  const errorButton =
    errorScreen?.querySelector<HTMLElement>("[data-auth-button]");

  if (errorScreen) {
    const retryHint =
      errorScreen.querySelector<HTMLElement>("[data-retry-hint]");

    window.addEventListener("chronos:auth-required", (event) => {
      const { attempt } = (event as CustomEvent<{ attempt: number }>).detail;
      errorScreen.classList.remove("hidden");
      errorScreen.classList.add("grid");
      if (retryHint) retryHint.hidden = attempt === 1;

      if (attempt > 1) {
        if (errorDescription)
          errorDescription.textContent =
            "Doesn't look right leh, try sending your name and password again.";
        if (errorButton) errorButton.textContent = "One more time";
      }
    });

    window.addEventListener("chronos:auth-restored", () => {
      errorScreen.classList.add("hidden");
      errorScreen.classList.remove("grid");
    });

    if (errorButton) {
      errorButton.addEventListener("click", () => {
        window.dispatchEvent(new Event("chronos:auth-retry"));
      });
    }
  }
</script>
